---
import { RiGithubLine, RiInstagramLine, RiLinkedinFill } from "@remixicon/react";
import { Button } from "@/components/ui/button";
import Animate from "./Animate";
import TextLoop from "./TextLoop";
import { roles } from "@/constants";

const socials = [
  {
    icon: RiGithubLine,
    link: "https://github.com/sankalp-mishra2005",
  },
  {
    icon: RiInstagramLine,
    link: "https://www.instagram.com/sankalpduttmishra/",
  },
  {
    icon: RiLinkedinFill,
    link: "https://www.linkedin.com/in/sankalp-mishra-b09328216/",
  },
];
---

<Animate
  client:load
  initial={{ opacity: 0, scale: 0.95 }}
  animate={{ opacity: 1, scale: 1 }}
  transition={{ duration: 1, ease: "easeOut" }}
  className="flex gap-8 items-center will-change-transform"
>
  <div>
    <h1 class="text-foreground text-xl">Sankalp.</h1>
    <TextLoop client:load words={roles} />
  </div>
  <div class="flex gap-2">
    {
      socials.map((social, ind) => {
        const Icon = social.icon;
        return (
          <Animate
            client:load
            initial={{ y: "10%", opacity: 0 }}
            animate={{ y: 0, opacity: 1 }}
            transition={{ duration: 1, delay: ind * 0.5 + 0.8 }}
          >
            <a target="_blank" href={social.link}>
              <Button variant={"secondary"} size={"icon"}>
                <Icon size={18} />
              </Button>
            </a>
          </Animate>
        );
      })
    }
  </div>
</Animate>
