---
import { motion } from 'framer-motion'
import { cosmic } from '@/lib/cosmic'

const { objects: _skills } = await cosmic.objects
  .find({ type: 'skills' })
  .props('slug,title,metadata')
  .depth(1)

const skills = _skills.concat(_skills)
---

<div
  class="absolute overflow-hidden max-w-80 sm:max-w-sm left-1/2 -translate-x-1/2 -translate-y-1/3"
  style={{
    mask: 'linear-gradient(90deg,transparent,white 40%,white 60%, transparent)'
  }}
>
  <ul class="flex gap-3 w-max animate-scroll">
    {
      skills.map((skill: any, i: number) => {
        return (
          <li class="flex flex-col items-center gap-1.5 px-3 py-1 bg-muted/80 dark:bg-muted/40 rounded-lg border border-border dark:border-border/40 backdrop-blur-xs min-w-[4.5rem]">
            <span class="text-[9px] text-muted-foreground font-bold tracking-wider select-none text-center">
              {skill.title}
            </span>
            <motion.img
              client:load
              initial={{ opacity: 0, scale: 0.8 }}
              animate={{ opacity: 1, scale: 1 }}
              transition={{
                delay: i * 0.05 + 0.5,
                ease: 'easeInOut',
                duration: 0.5
              }}
              className={`size-7 object-contain filter drop-shadow-[0_1px_1.5px_rgba(0,0,0,0.12)] dark:drop-shadow-none ${skill.title === 'Next.js' ? 'dark:invert' : ''}`}
              src={skill.metadata.logo.url}
              alt={skill.title}
            />
          </li>
        )
      })
    }
  </ul>
</div>
